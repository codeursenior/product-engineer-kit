{
  "name": "@codeursenior/boyscout",
  "version": "0.1.3",
  "description": "Agent Visualizer: explore your AI context, skills and MCP configuration in a local dashboard.",
  "type": "module",
  "bin": {
    "boyscout": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsx scripts/clean.ts && npm run build:server && ng build",
    "build:server": "tsc -p tsconfig.json",
    "prestart": "npm run build",
    "start": "node dist/cli.js ui",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && ngc -p tsconfig.app.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "test": "npm run test:server && npm run test:ui",
    "test:server": "vitest run --config vitest.config.ts",
    "test:ui": "ng test --watch=false",
    "test:coverage": "npm run test:server -- --coverage && npm run test:ui -- --coverage",
    "test:e2e": "playwright test",
    "test:package": "tsx scripts/package-smoke.ts",
    "test:reproducibility": "tsx scripts/reproducibility.ts",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "prepack": "npm run build",
    "format": "prettier --write ."
  },
  "keywords": [
    "agents",
    "codex",
    "copilot",
    "claude",
    "cursor",
    "mcp",
    "skills",
    "visualizer"
  ],
  "author": "Simon Dieny",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeursenior/product-engineer-kit.git",
    "directory": "packages/agent-visualizer"
  },
  "homepage": "https://github.com/codeursenior/product-engineer-kit/tree/main/packages/agent-visualizer#readme",
  "bugs": "https://github.com/codeursenior/product-engineer-kit/issues",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.4.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.0",
    "@angular/cli": "22.2.0",
    "@angular/common": "22.2.0",
    "@angular/compiler": "22.2.0",
    "@angular/compiler-cli": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "@playwright/test": "1.63.0",
    "@types/d3": "7.4.3",
    "@types/node": "22.20.4",
    "@types/node20": "npm:@types/node@20.19.43",
    "@vitest/coverage-v8": "5.0.3",
    "angular-eslint": "22.5.0",
    "d3": "^7.9.0",
    "eslint": "10.11.0",
    "jiti": "2.7.0",
    "jsdom": "30.1.1",
    "prettier": "^3.9.8",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
