{
  "name": "product-engineer-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present && node --test skills/pek-grill-me/test/*.test.mjs scripts/test/*.test.mjs",
    "check": "npm run build && npm test",
    "release:status": "node scripts/release-status.mjs",
    "start": "npm run start --workspace @codeursenior/boyscout --",
    "format": "npm run format --workspaces --if-present && prettier --write README.md docs skills package.json .github"
  },
  "devDependencies": {
    "prettier": "^3.9.8"
  },
  "engines": {
    "node": ">=20"
  }
}
